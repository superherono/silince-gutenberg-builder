{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "{{NAMESPACE}}/{{BLOCK_NAME}}",
	"version": "1.0.0",
	"title": "{{BLOCK_TITLE}}",
	"category": "common",
	"description": "{{BLOCK_DESCRIPTION}}",
	"keywords": ["button", "link", "cta"],
	"icon": "button",
	"textdomain": "{{TEXTDOMAIN}}",
	"attributes": {
		"buttonText": {
			"type": "string",
			"default": "More about us"
		},
		"buttonUrl": {
			"type": "string",
			"default": "#"
		},
		"buttonTarget": {
			"type": "string",
			"default": "_self"
		},
		"buttonRel": {
			"type": "string",
			"default": ""
		},
		"buttonSize": {
			"type": "string",
			"default": "medium",
			"enum": ["small", "medium", "large"]
		},
		"buttonVariant": {
			"type": "string",
			"default": "primary",
			"enum": ["primary", "secondary", "tertiary", "text"]
		},
		"showIcon": {
			"type": "boolean",
			"default": true
		},
		"customIcon": {
			"type": "string",
			"default": "<svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M5 12H19M19 12L12 5M19 12L12 19\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
		},
		"backgroundColor": {
			"type": "string",
			"default": ""
		},
		"backgroundColorHover": {
			"type": "string",
			"default": ""
		},
		"textColor": {
			"type": "string",
			"default": ""
		},
		"iconBackgroundColor": {
			"type": "string",
			"default": ""
		},
		"iconColor": {
			"type": "string",
			"default": ""
		},
		"justifyContent": {
			"type": "string",
			"default": "flex-start",
			"enum": ["flex-start", "center", "flex-end"]
		},
		"buttonFontSize": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"className": true,
		"align": false,
		"anchor": true,
		"typography": {
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": ["horizontal", "vertical"],
			"__experimentalDefaultControls": {
				"padding": true
			}
		},
		"__experimentalBorder": {
			"color": false,
			"radius": true,
			"style": false,
			"width": false,
			"__experimentalDefaultControls": {
				"color": false,
				"radius": true,
				"style": false,
				"width": false
			}
		},
		"shadow": true
	}
}
